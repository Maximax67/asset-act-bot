BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=-1001234567890
MESSAGE_THREAD_ID=

# Deployment mode
# "webhook" for Vercel/server, "polling" for local dev
MODE=webhook

WEBHOOK_URL=https://your-app.vercel.app
WEBHOOK_SECRET=some_random_secret_string
WEBHOOK_MANAGE_TOKEN=some_admin_management_token

GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

ASSETS_SHEET_ID=your_assets_spreadsheet_id_here
ASSETS_SHEET_NAME=Sheet1
DEPARTMENTS_SHEET_ID=your_departments_spreadsheet_id_here
DEPARTMENTS_SHEET_NAME=Sheet1

# Can be a Shared Drive root ID or a regular folder ID
SHARED_DRIVE_ID=your_drive_folder_or_shared_drive_id

DOC_GENERATOR_BASE_URL=https://example.com
DOCUMENT_ID=your_document_template_id_here
# "docx" or "pdf"
DOC_FORMAT=docx

# File naming ({date} and {deptname} are placeholders)
FILE_NAME_PATTERN="{date} Акт. {deptname}"

# Number formatting (Ukrainian locale defaults)
THOUSAND_SEPARATOR=" "
DECIMAL_SEPARATOR=","
CURRENCY_SUFFIX=
ALLOW_ROUNDING_ADJUST=true
